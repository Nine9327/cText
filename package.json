{
  "name": "ctext",
  "version": "0.1.0",
  "private": true,
  "description": "cText - 本地优先的 Windows 桌面小说阅读器",
  "author": "Nine9327",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nine9327/cText.git"
  },
  "homepage": "https://github.com/Nine9327/cText#readme",
  "bugs": {
    "url": "https://github.com/Nine9327/cText/issues"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:raw": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "start": "node scripts/dev.mjs preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.web.json",
    "check:env": "node scripts/verify-env.mjs",
    "check:env:electron": "node scripts/run-electron-check.mjs",
    "verify:shell": "node scripts/verify-shell.mjs",
    "verify:db": "node scripts/verify-db.mjs",
    "rebuild:native": "electron-rebuild -f -o better-sqlite3 --build-from-source -d https://artifacts.electronjs.org/headers/dist",
    "setup:python": "node scripts/setup-python.mjs",
    "postinstall": "pnpm rebuild:native",
    "verify:ipc": "node scripts/verify-ipc.mjs",
    "verify:bridge": "node scripts/verify-bridge.mjs",
    "verify:log": "node scripts/verify-log.mjs",
    "verify:ui": "node scripts/verify-ui.mjs",
    "make:icons": ".venv\\Scripts\\python.exe scripts/make-icons.py",
    "build:worker": "node scripts/build-worker.mjs",
    "dist:dir": "electron-vite build && node scripts/dist.mjs --win --dir",
    "dist": "electron-vite build && node scripts/dist.mjs --win",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:roots": "node scripts/verify-roots.mjs",
    "verify:scan": "node scripts/verify-scan.mjs",
    "verify:dedupe": "node scripts/verify-dedupe.mjs",
    "verify:txt": "node scripts/verify-txt.mjs",
    "verify:epub": "node scripts/verify-epub.mjs",
    "verify:import": "node scripts/verify-import.mjs",
    "verify:import:ui": "node scripts/verify-import-ui.mjs",
    "verify:list": "node scripts/verify-list.mjs",
    "verify:search": "node scripts/verify-search.mjs",
    "verify:m1": "node scripts/verify-m1.mjs",
    "verify:reader": "node scripts/verify-reader.mjs",
    "verify:reader:big": "node scripts/verify-reader-big.mjs",
    "verify:reader:ui": "node scripts/verify-reader-ui.mjs",
    "verify:settings": "node scripts/verify-settings.mjs",
    "verify:settings:ui": "node scripts/verify-settings-ui.mjs",
    "verify:progress": "node scripts/verify-progress.mjs",
    "verify:m2": "node scripts/verify-m2.mjs",
    "verify:favorite": "node scripts/verify-favorite.mjs",
    "verify:shelf": "node scripts/verify-shelf.mjs",
    "verify:category": "node scripts/verify-category.mjs",
    "verify:detail": "node scripts/verify-detail.mjs",
    "verify:batch": "node scripts/verify-batch.mjs",
    "verify:rematch": "node scripts/verify-rematch.mjs",
    "verify:m3": "node scripts/verify-m3.mjs",
    "verify:rule-parser": "node scripts/verify-rule-parser.mjs",
    "verify:css": "node scripts/verify-css-extractor.mjs",
    "verify:selectors": "node scripts/verify-selectors.mjs",
    "verify:regex": "node scripts/verify-regex-extractor.mjs",
    "verify:http": "node scripts/verify-http.mjs",
    "verify:js": "node scripts/verify-js.mjs",
    "verify:sources": "node scripts/verify-sources.mjs",
    "verify:sources:ui": "node scripts/verify-sources.mjs --ui",
    "verify:source-search": "node scripts/verify-source-search.mjs",
    "verify:source-book": "node scripts/verify-source-book.mjs",
    "verify:source-book:ui": "node scripts/verify-source-book.mjs --ui",
    "verify:source-cache": "node scripts/verify-source-cache.mjs",
    "verify:source-debug": "node scripts/verify-source-debug.mjs",
    "verify:source-compat": "node scripts/verify-source-compat.mjs",
    "compat:report": "node scripts/compat-report.mjs"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "better-sqlite3": "^11.10.0",
    "cheerio": "^1.2.0",
    "iconv-lite": "^0.7.3",
    "jsonpath-plus": "^11.2.2",
    "pinia": "^2.3.0",
    "quickjs-emscripten": "^0.32.0",
    "undici": "^7.30.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "xpath": "^0.0.36",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "electron": "^32.2.6",
    "electron-builder": "^26.18.0",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vue-tsc": "^2.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
